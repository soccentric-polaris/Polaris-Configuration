# Default environment for webconfigd (spec §2/§4.8). Overridable per-deployment.
# TLS listen port (spec §2).
WEBCONFIG_PORT=8443
# Platform id: always "polaris" (this repo is Polaris-only). Override via a
# bbappend if a dev/CI build needs the generic fallback (see webconfig-manifest
# recipe).
WEBCONFIG_PLATFORM=polaris
# Sysroot is "/" in production; left unset here so the daemon defaults to /.
# WEBCONFIG_SYSROOT=/
# Static asset dir installed by webconfig-static.
WEBCONFIG_STATIC_DIR=/usr/share/webconfig/static
# Logging verbosity.
RUST_LOG=info